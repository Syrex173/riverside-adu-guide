---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Free ADU Property Prep Check | Riverside ADU Guide"
  description="Get a free property prep check to see what your Riverside property may support for an ADU project."
>
  <h1>Free ADU Property Prep Check</h1>
  <p>Fill out the form below and we'll help you understand what your property may support before you talk to a contractor.</p>

  <form action="PASTE_FORMSPREE_ENDPOINT_HERE" method="POST">
    <label for="name">Name
      <input type="text" id="name" name="name" required />
    </label>

    <label for="email">Email
      <input type="email" id="email" name="email" required />
    </label>

    <label for="phone">Phone
      <input type="tel" id="phone" name="phone" required />
    </label>

    <label for="address">Property Address
      <input type="text" id="address" name="address" required />
    </label>

    <label for="city">City
      <input type="text" id="city" name="city" required />
    </label>

    <label for="project_type">Project Type
      <select id="project_type" name="project_type" required>
        <option value="">Select one</option>
        <option value="Garage Conversion">Garage Conversion</option>
        <option value="Junior ADU">Junior ADU</option>
        <option value="New Detached ADU">New Detached ADU</option>
        <option value="Not Sure">Not Sure</option>
      </select>
    </label>

    <label for="main_goal">Main Goal
      <input type="text" id="main_goal" name="main_goal" />
    </label>

    <label for="timeline">Timeline
      <select id="timeline" name="timeline" required>
        <option value="">Select one</option>
        <option value="ASAP">ASAP</option>
        <option value="3-6 months">3-6 months</option>
        <option value="6-12 months">6-12 months</option>
        <option value="Just researching">Just researching</option>
      </select>
    </label>

    <label for="budget_range">Budget Range
      <select id="budget_range" name="budget_range" required>
        <option value="">Select one</option>
        <option value="Under $50k">Under $50k</option>
        <option value="$50k-$100k">$50k-$100k</option>
        <option value="$100k-$150k">$100k-$150k</option>
        <option value="$150k+">$150k+</option>
        <option value="Not sure">Not sure</option>
      </select>
    </label>

    <label for="biggest_question">Biggest Question
      <textarea id="biggest_question" name="biggest_question"></textarea>
    </label>

    <button type="submit">Submit</button>
  </form>
</BaseLayout>
